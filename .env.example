# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Colyseus server (../Boat-race-with-99-engine-backend) for the local dev server only (`npm run dev`,
# defaults to ws://localhost:2567). It holds the only save (nothing is kept in the browser). Built
# games (`npm run build` / `build:dev`) ignore it and always connect through the Bloxity matchmaker.
VITE_SERVER_URL_DEV=
