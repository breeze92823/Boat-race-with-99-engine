# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Colyseus server (../Boat-race-with-99-engine-backend), one URL per Bloxity Legion channel. It holds the
# only save (nothing is kept in the browser). `npm run dev` / `build:dev` use _DEV (npm run dev defaults
# to ws://localhost:2567); `npm run build` uses _MAIN. Leave a URL empty to let the Bloxity SDK resolve
# that channel's endpoint at runtime.
VITE_SERVER_URL_DEV=
VITE_SERVER_URL_MAIN=
